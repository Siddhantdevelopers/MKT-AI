rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      // In this app, we'll use a simple admin collection check or hardcoded email for bootstrap
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'siddhantsid662@gmail.com'
      );
    }

    function isValidUser(data) {
      return data.username is string && data.username.size() >= 3 && data.username.size() <= 50 &&
             data.password is string && data.password.size() >= 8;
    }

    function isValidLicense(data) {
      return data.key is string && data.key.size() > 0 &&
             data.days is number && data.days > 0 &&
             data.maxClaims is number && data.maxClaims >= 1;
    }

    // Users collection
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && (
        // Allow updating license info
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['license'])
      ) || isAdmin();
    }

    // Licenses collection
    match /licenses/{licenseId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
      
      // Special allow for users to increment claims
      allow update: if isSignedIn() && 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claims', 'claimantIds']) &&
        request.resource.data.claims == resource.data.claims + 1 &&
        request.resource.data.claimantIds.size() == resource.data.claimantIds.size() + 1 &&
        request.auth.uid in request.resource.data.claimantIds;
    }

    // Admins collection (strictly for role-based access)
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if false; // Only manageable via console or specialized tool
    }
  }
}
