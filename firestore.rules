rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      // In this app, we'll use a simple admin collection check or hardcoded email for bootstrap
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'siddhantsid662@gmail.com'
      );
    }

    function isValidUser(data) {
      return data.username is string && data.username.size() >= 3 && data.username.size() <= 50 &&
             data.password is string && data.password.size() >= 8;
    }

    function isValidLicense(data) {
      return data.key is string && data.key.size() > 0 &&
             data.days is number && data.days > 0 &&
             data.maxClaims is number && data.maxClaims >= 1;
    }

    // Users collection
    match /users/{userId} {
      allow read, create: if true;
      allow update: if true; // In production, restrict to isOwner(userId) or isAdmin()
      allow delete: if isAdmin();
    }

    // Licenses collection
    match /licenses/{licenseId} {
      allow read: if true;
      allow write: if true; // In production, restrict to isAdmin()
    }

    // Admins collection (strictly for role-based access)
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if false; // Only manageable via console or specialized tool
    }
  }
}
